# Base URL of the CampusRide FastAPI backend (including the /api/v1 prefix).
# The backend's CORS_ORIGINS must include this app's origin (default http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8000/api/v1
# The Admin web app's sign-in page (the "Admin" choice on the CampusRide sign-in page links here).
VITE_ADMIN_APP_URL=http://localhost:5174/
