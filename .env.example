# CampusRide — copy to .env (repo root) and adjust. All values shown are defaults.

# --- app ---
APP_ENV=dev                          # dev | test | prod
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CAMPUS_TIMEZONE=Asia/Kolkata

# --- database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=campusride
TELEMETRY_TTL_DAYS=30

# --- auth ---
AUTH_MODE=mock                       # mock | firebase (firebase arrives in Phase 7)
MOCK_TOKEN_SECRET=dev-only-change-me # signs mock bearer tokens (HMAC-SHA256)
MOCK_TOKEN_TTL_S=604800
FIREBASE_PROJECT_ID=                 # unused while AUTH_MODE=mock

# --- clock / simulator ---
CLOCK_MODE=sim                       # sim | real
SEED=42
SIM_ENABLED=true
SIM_AUTOSTART=true                   # buses start moving when the API starts
SIM_START_DATE=auto                  # auto = next weekday after today; or YYYY-MM-DD
SIM_START_TIME=07:15                 # campus local time
SIM_SPEED=5                          # one of 1, 2, 5, 10, 20
SIM_TICK_S=1.0                       # sim-time physics step
SIM_TELEMETRY_INTERVAL_S=5           # how often a simulated "phone" pings
SIM_GPS_NOISE_SIGMA_M=8
SIM_DROPOUT_PROB=0.01                # chance per ping that a 10–30 s dropout starts

# --- tracking thresholds (used from Phase 2 / 6) ---
STOP_ARRIVAL_RADIUS_M=40
STOP_APPROACHING_M=1000              # "approaching" when the stop is this far ahead along the route
BUS_STALE_AFTER_S=45
DEVIATION_THRESHOLD_M=150
DEVIATION_CONSECUTIVE_PINGS=3

# --- commute decision (Feature 7, prototype values) ---
WALKING_SPEED_MPS=1.4          # fallback when a student profile has no walking speed
COMMUTE_SAFETY_BUFFER_S=120    # arrive at least 2 min before the bus
STUDENT_LOCATION_MODE=synthetic  # synthetic (demo location, no GPS) | off
