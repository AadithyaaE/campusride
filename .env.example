# CampusRide — copy to .env (repo root) and adjust. All values shown are defaults.

# --- app ---
APP_ENV=dev                          # dev | test | prod
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CAMPUS_TIMEZONE=Asia/Kolkata

# --- database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=campusride
TELEMETRY_TTL_DAYS=30

# --- auth ---
# Authentication (Feature 15, docs/authentication.md)
AUTH_MODE=password                        # dev (DEVELOPMENT sign-in, no password — never prod) | password | oidc
AUTH_TOKEN_SECRET=dev-only-change-me # signs backend session tokens; APP_ENV=prod needs >= 32 random chars
AUTH_TOKEN_TTL_S=43200               # session lifetime (wall-clock seconds)
# AUTH_MODE=oidc — an external OpenID Connect provider, e.g. Firebase Auth (public keys only, no secrets):
OIDC_ISSUER=                         # https://securetoken.google.com/<firebase-project-id>
OIDC_AUDIENCE=                       # <firebase-project-id>
OIDC_JWKS_URL=                       # https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
OIDC_LINK_BY_EMAIL=false             # link a first sign-in to the seeded user with the same VERIFIED email

# --- clock / simulator ---
CLOCK_MODE=sim                       # sim | real
SEED=42
SIM_ENABLED=true
SIM_AUTOSTART=true                   # buses start moving when the API starts
SIM_START_DATE=auto                  # auto = next weekday after today; or YYYY-MM-DD
SIM_START_TIME=07:15                 # campus local time
SIM_SPEED=5                          # one of 1, 2, 5, 10, 20
SIM_TICK_S=1.0                       # sim-time physics step
SIM_TELEMETRY_INTERVAL_S=5           # how often a simulated "phone" pings
SIM_GPS_NOISE_SIGMA_M=8
SIM_DROPOUT_PROB=0.01                # chance per ping that a 10–30 s dropout starts

# --- tracking thresholds (used from Phase 2 / 6) ---
STOP_ARRIVAL_RADIUS_M=40
STOP_APPROACHING_M=1000              # "approaching" when the stop is this far ahead along the route
BUS_STALE_AFTER_S=45

# --- route deviation (Feature 10). Thresholds must stay above synthetic GPS noise
# (SIM_GPS_NOISE_SIGMA_M=8 per axis → a route-following bus stays within ~35 m).
ROUTE_MINOR_DEVIATION_M=50      # > 50 m from the planned route  → MINOR_DEVIATION
ROUTE_MAJOR_DEVIATION_M=150     # ≥ 150 m from the planned route → MAJOR_DEVIATION (+ alert)
SIM_DRIVER_CONTROLLED_BUSES=B07     # Feature 12: buses whose trips start/stop from the Driver App
SIM_DEVIATION_MINOR_OFFSET_M=100   # demo "minor" mode: simulated GPS shifted 100 m sideways
SIM_DEVIATION_MAJOR_OFFSET_M=300   # demo "major" mode: simulated GPS shifted 300 m sideways

# --- commute decision (Feature 7, prototype values) ---
WALKING_SPEED_MPS=1.4          # fallback when a student profile has no walking speed
COMMUTE_SAFETY_BUFFER_S=120    # arrive at least 2 min before the bus
STUDENT_LOCATION_MODE=synthetic  # synthetic (demo location, no GPS) | off

# --- missed-bus recovery (Feature 9, prototype values) ---
RECOVERY_DELAY_THRESHOLD_S=300   # assigned bus ≥ 5 min late → offer recovery options
RECOVERY_MAX_ALTERNATIVES=3

# --- in-app alerts (Feature 11). Delay alerts reuse the existing 5-min delayed rule;
# deviation alerts reuse ROUTE_*_DEVIATION_M. Delivered over the WebSocket (Feature 14).
ALERT_APPROACHING_WINDOW_MINUTES=5   # BUS_APPROACHING when the assigned bus is ≤ 5 min away
ALERT_CAPACITY_WARNING_PERCENT=80    # CAPACITY_WARNING at ≥ 80 % occupied
ALERT_EVALUATION_INTERVAL_S=15       # student alert sweep, simulation seconds
ALERT_EVALUATION_MIN_WALL_S=5        # …but at most every 5 wall-clock seconds
ALERT_STUDENT_ROUTE_DEVIATION=true   # also notify assigned students of a major deviation

# --- real-time WebSocket push (Feature 14, wall-clock seconds; see docs/realtime.md) ---
WS_AUTH_TIMEOUT_S=10          # first message must authenticate within this time
WS_HEARTBEAT_S=20             # server ping interval (clients answer pong)
WS_IDLE_TIMEOUT_S=60          # close sockets silent for this long
WS_FLUSH_INTERVAL_S=1         # bus updates coalesced, pushed at most once per interval
WS_OVERVIEW_MIN_INTERVAL_S=2  # admin KPI push at most this often
WS_QUEUE_SIZE=500             # per-socket send queue; slower clients are disconnected
