# CampusRide backend — PRODUCTION environment (Render). Placeholders only: never commit real values.
# Set these in the Render dashboard → service → Environment. See docs/deployment.md.

# --- app ---
APP_ENV=prod                         # enables the production safety checks (no dev sign-in, strong secret)
LOG_LEVEL=INFO
# Comma-separated, exact origins (scheme + host, no trailing slash) of the two Vercel apps:
CORS_ORIGINS=https://<student-app>.vercel.app,https://<admin-app>.vercel.app
CAMPUS_TIMEZONE=Asia/Kolkata

# --- database (MongoDB Atlas) — SECRET ---
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority&appName=campusride
MONGO_DB=campusride

# --- auth — SECRET ---
AUTH_MODE=password                   # email + password; AUTH_MODE=dev is refused when APP_ENV=prod
AUTH_TOKEN_SECRET=<at-least-32-random-characters>   # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_TTL_S=43200

# --- simulator policy ---
# Default for a real deployment: NO simulated buses.
CLOCK_MODE=real
SIM_ENABLED=false
SIM_AUTOSTART=false
# SIH public demo (deliberate opt-in): set CLOCK_MODE=sim, SIM_ENABLED=true, SIM_AUTOSTART=true.
# The simulator then drives the synthetic fleet; only admins can pause/speed/reset it.
# NOTE: on every backend start it resets the DEMO DAY's runtime data for simulated buses
# (positions, telemetry, that day's boardings and alerts). Users, routes and seed data are untouched.
# SIM_SPEED=5
# SIM_DRIVER_CONTROLLED_BUSES=B07

# --- student location ---
STUDENT_LOCATION_MODE=synthetic      # demo location near the boarding stop (no real GPS yet); or off
